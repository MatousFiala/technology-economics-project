@article{CORNAGO2023102821,
title = {The impact of urban road pricing on the use of bike sharing},
journal = {Journal of Environmental Economics and Management},
volume = {120},
pages = {102821},
year = {2023},
issn = {0095-0696},
doi = {https://doi.org/10.1016/j.jeem.2023.102821},
url = {https://www.sciencedirect.com/science/article/pii/S0095069623000396},
author = {Elisabetta Cornago and Alexandros Dimitropoulos and Walid Oueslati},
keywords = {Urban road pricing, Transport choice, Bike sharing, Zero-carbon mobility},
abstract = {We empirically analyse the effect of road pricing on the use of bike sharing. We exploit two sudden policy changes in Milan's congestion pricing scheme resulting in a shift from priced to unpriced road use: a temporary suspension of the scheme in 2012, and a durable reduction in its application schedule. We find that the sudden removal of road pricing decreases bike-sharing use by about 5\%. The policy impact mainly occurs through the increase of road traffic congestion, which makes cycling less safe and pleasant. The reduction in the schedule leads to an 8\% decline in bike-sharing use in the affected time window. Our findings indicate that policies inducing drivers to internalise the external costs of car use also promote the uptake of non-polluting transport modes. This widens the spectrum of benefits that need to be considered in the design and implementation of road pricing policies.}
}

