\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Average log weekly rides ended at treated (inside toll zone) and control (outside zone) stations, January 2024 -- early 2026. GAM smooths are fitted separately for the pre- and post-toll periods (dashed line = January 5, 2025). A strong seasonal pattern dominates both groups; no immediate visual shift is apparent at the toll introduction.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:trends_raw}{{1}{4}{Average log weekly rides ended at treated (inside toll zone) and control (outside zone) stations, January 2024 -- early 2026. GAM smooths are fitted separately for the pre- and post-toll periods (dashed line = January 5, 2025). A strong seasonal pattern dominates both groups; no immediate visual shift is apparent at the toll introduction}{figure.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Methodology}{4}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Difference in Differences}{4}{subsection.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Seasonally adjusted parallel trends. Plotted values are residuals from a regression of log weekly rides ended on station$\times $month and week fixed effects. Pre-toll trends are nearly parallel, supporting the parallel trends assumption. A modest upward shift for the treated group is visible immediately after the toll introduction.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:trends_adj}{{2}{5}{Seasonally adjusted parallel trends. Plotted values are residuals from a regression of log weekly rides ended on station$\times $month and week fixed effects. Pre-toll trends are nearly parallel, supporting the parallel trends assumption. A modest upward shift for the treated group is visible immediately after the toll introduction}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Regression Discontinuity}{5}{subsection.4.2}\protected@file@percent }
